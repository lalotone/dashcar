CONFIG_IDF_TARGET="esp32s3"

# Flash: 16MB QIO @ 80MHz (ESP32-S3-WROOM-1-N16R8)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU / caches (as in the Waveshare demo)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# PSRAM: 8MB octal
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# RGB LCD: keep the panel stable while Wi-Fi/flash are busy
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# Networking / TLS
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# LVGL 9
CONFIG_LV_OS_FREERTOS=y
# LVGL heap lives in PSRAM (main/lv_mem_psram.c)
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_FILE_SUPPORT=n
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y

# Internal RAM budget: the RGB bounce buffers and LVGL's partial draw buffer must be
# internal, so keep Wi-Fi hot paths in flash instead of IRAM.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
# HW AES needs internal DMA bounce buffers that the display already competes for.
CONFIG_MBEDTLS_HARDWARE_AES=n
# Keep 64KB of internal RAM for allocations that explicitly need it (Wi-Fi, lwIP, DMA);
# plain malloc() (LVGL objects, glyph cache...) falls back to PSRAM instead.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# lv_snapshot: lets debug builds dump the screen over serial
CONFIG_LV_USE_SNAPSHOT=y
# QR codes (Google Maps navigation links in the Fuel app)
CONFIG_LV_USE_QRCODE=y

# OTA: a new image must confirm itself (ota_mark_valid_later) or the bootloader rolls back.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# Wi-Fi state listeners run in the system event task (UI navigation, starting services).
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# Lets big static buffers live in PSRAM via EXT_RAM_BSS_ATTR (UI scratch arrays).
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
